---
import Logo from "../components/Logo.astro";
import Layout from '../layouts/Layout.astro';

export const prerender = true;

/* ------------------------------------------------------------------
   EDIT HERE. Everything below is a fact only you can supply.
   Leave a value as '' and the page shows a neutral fallback instead
   of an empty gap or a visible placeholder.
------------------------------------------------------------------- */
const settings = {
  pilotStart: 'late January 2027',     
  pilotPlaces: '4',    
  groupPrice: 'R1950 per student',     
  oneToOnePrice: 'R2450', 
  sessionTime: 'Thuesdays at 17:00, South African time',    
  platform: 'Google Classroom and Google Meet',       
  aiPolicy: 'The sentences you submit must be your own writing.',       
  
  bio: 'Dr. John Oosthuizen holds a PhD in Music and has taught music theory and analysis at Stellenbosch University. He also worked as a senior enterprise architect at IBM, which shaped his habit of stating a problem, its boundaries, and its evidence in plain terms.',
};

const or = (value: string, fallback: string) => (value.trim() ? value.trim() : fallback);

const pilotLine = `Free pilot places${settings.pilotPlaces.trim() ? ` (${settings.pilotPlaces.trim()} available)` : ''}, starting ${or(settings.pilotStart, 'on a date to be confirmed')}.`;

const weeks = [
  { week: '0', focus: 'Start', write: 'Send me what you have, even rough notes.' },
  { week: '1', focus: 'The wide opening', write: 'One sentence: what is changing in your field, and what is missing.' },
  { week: '2', focus: 'The narrow middle', write: 'One question: your approach, your boundaries, and your evidence.' },
  { week: '3', focus: 'The wide base', write: 'One sentence: your answer, and why it matters.' },
  { week: '4', focus: 'Putting it together', write: 'Read all three aloud, trim, and finish.' },
];

const problems = [
  {
    title: 'Backstory instead of the gap',
    looks: 'The opening is history and background, and the gap never arrives.',
    before: 'Since the early nineteenth century, piano music has developed in many directions, and Brahms’s late works have long been admired.',
    fix: 'Start with what is missing: “Little work shows how a student pianist can use analysis to make phrasing decisions in Brahms’s late pieces.”',
  },
  {
    title: 'No boundaries',
    looks: 'Nothing says what the study includes and what it leaves out.',
    before: 'The study will also consider history, performance practice, psychology and other factors that may play a role.',
    fix: 'Say what is in and what is out: “It examines my own preparation of Op. 117 No. 1 and leaves out other pianists’ recordings.”',
  },
  {
    title: 'Big claim, small evidence',
    looks: 'A claim much bigger than the evidence, or an answer much smaller than the problem.',
    before: 'This study will transform how all pianists approach late Romantic music, using one student’s practice sessions.',
    fix: 'Size the claim to the evidence: “It gives student performers a repeatable way to justify their phrasing choices.”',
  },
  {
    title: 'Method named, not explained',
    looks: 'A method or tool is named, but not what you do with it.',
    before: 'Does using Sibelius, Sonic Visualiser and Schenkerian analysis help with the Brahms?',
    fix: 'Say what goes in, what you do and what comes out: “I map the phrase structure, then record my phrasing decisions at three practice stages.”',
  },
  {
    title: 'Word fluff',
    looks: 'Padding, hedging and emotional words that bury your point.',
    before: 'Many deeply passionate musicians feel that Brahms’s incredibly profound late works are truly impossible to understand.',
    fix: 'Cut to the point: “Brahms’s late intermezzi reward close study of phrase structure.”',
  },
];

const faqs = [
  {
    q: 'Do I need a topic?',
    a: 'A rough idea is enough. Week 0 has a route for starting from scratch.',
  },
  {
    q: 'Does this replace my supervisor?',
    a: 'No. I coach how your argument is built. Your supervisor guides the content and the field.',
  },
  {
    q: 'Will you write or edit my work?',
    a: 'No. I give written feedback on your own sentences and help you rewrite them in the session.',
  },
  {
    q: 'What do you not check?',
    a: 'Spelling, grammar and referencing, academic integrity, and whether your findings are true. I look at how your argument is built.',
  },
  {
    q: 'Is this for performers, or only for theorists?',
    a: 'It is for any area of music research: performance, theory and analysis, musicology, ethnomusicology, music education and more. I coach how your argument is built. The content stays with you and your supervisor.',
  },
  {
    q: 'What do I hand in each week?',
    a: 'One sentence, written in your Working Document. It locks to view-only 24 hours before your live session, so I can read it first. Nothing else is due.',
  },
  {
    q: 'How is my progress measured?',
    a: 'At the start, I mark a sample of your existing writing against the five common argument problems. At the end, I mark your final three sentences against the same five. You see both sets of marks and the difference between them. These marks come from a marking sheet for writing, and have nothing to do with musical scores.',
  },
  {
    q: 'Will the other students see my work?',
    a: 'In your session, yes. The other three students hear your sentence and watch it being rewritten, and each listens for one idea to use on their own sentence. Feedback is always about the writing, never the writer, and nervous students read first.',
  },
  {
    q: 'Can I use AI tools?',
    a: or(settings.aiPolicy, 'The sentences you submit must be your own writing.'),
  },
  {
    q: 'What do I need?',
    a: `A computer and a stable internet connection. We use ${or(settings.platform, 'an online classroom and video calls')}.`,
  },
  {
    q: 'When are the sessions?',
    a: `${or(settings.sessionTime, 'Session times are agreed with each group')}. Ask if you are in another time zone.`,
  },
  {
    q: 'What happens to my information?',
    a: 'I use it only to run the clinic and reply to you. You can ask me to delete it at any time. Read the privacy notice for details.',
  },
];
---

<Layout
  title="The Thesis Hourglass | Clear thesis arguments for music postgraduates"
  description="A four-week online clinic for music postgraduates. Groups of four. Write three sentences that describe your whole argument, with written feedback every week."
>
  <main class="pipeline-main">

    <header class="hero-section container">
      <div class="brand-monogram">
        <Logo />
      </div>

      <h1>Write a thesis argument that holds up</h1>
      <p class="tagline">
        A four-week online clinic for music postgraduates. Groups of four. Your own writing, with written feedback and a live rewrite every week.
      </p>

      <div class="hero-actions">
        <a class="button-primary" href="/register">Apply for a place</a>
        <a class="button-secondary" href="#how-it-works">See how it works</a>
      </div>
      <p class="hero-note">{pilotLine}</p>
    </header>

    <section class="container audience-section" aria-labelledby="who-heading">
      <h2 id="who-heading">Who it is for</h2>
      <div class="two-col">
        <div>
          <ul class="plain-list">
            <li>Performance students writing a half-thesis or written commentary</li>
            <li>Masters and doctoral students preparing a research proposal</li>
            <li>Theory and analysis students who want a sharper argument</li>
            <li>Anyone who knows their topic well but cannot yet state the argument in a few clear sentences</li>
          </ul>
        </div>
        <div class="note-box">
          <h3>What it is not</h3>
          <p>
            It is not editing, proofreading or writing for you, and it does not replace your supervisor. I coach the structure and logic of your argument. The ideas and the work stay yours.
          </p>
        </div>
      </div>
    </section>

    <section class="container leave-section" aria-labelledby="leave-heading">
      <h2 id="leave-heading">What you leave with</h2>
      <ol class="plain-list ordered">
        <li>Three sentences that describe the argument of your thesis or proposal</li>
        <li>A research question you can say aloud in one breath</li>
        <li>A short guide to five common argument problems, and how to spot them in your own writing</li>
        <li>Written comments on each sentence, so you know what to revise next</li>
      </ol>
    </section>

    <section class="hourglass-section container" aria-labelledby="hourglass-heading">
      <h2 id="hourglass-heading">The hourglass in one minute</h2>
      <p class="section-desc">
        A good argument is balanced. It does not open with a huge claim and end with a tiny one.
      </p>
      <div class="hourglass-layout">
        <svg class="hourglass-figure" viewBox="0 0 220 260" role="img" aria-label="An hourglass: wide at the top, narrow in the middle, wide at the base">
          <path d="M30 20h160L120 130l70 110H30l70-110z" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="hourglass-parts">
          <div class="matrix-node">
            <h3>The wide opening</h3>
            <p>The big picture: what is changing in your field, and what is still missing from it.</p>
          </div>
          <div class="matrix-node active-core">
            <h3>The narrow middle</h3>
            <p>Exactly what you will do, within what boundaries, and on what evidence. This is your research question.</p>
          </div>
          <div class="matrix-node">
            <h3>The wide base</h3>
            <p>What your work shows and why it matters, at the same scale as the problem you opened with.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="coaching-section container" aria-labelledby="how-heading">
      <h2 id="how-heading">How it works</h2>
      <div class="table-responsive">
        <table class="pricing-table" aria-label="The four-week programme">
          <thead>
            <tr><th scope="col">Week</th><th scope="col">Focus</th><th scope="col">You write</th></tr>
          </thead>
          <tbody>
            {weeks.map((w) => (
              <tr>
                <td>{w.week}</td>
                <td><strong>{w.focus}</strong></td>
                <td>{w.write}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="payoff">
        These three sentences can form the basis of a research proposal, a thesis abstract, and an entire thesis.
      </p>
      <div class="inverted-classroom-callout">
        <h3>Write first, then meet</h3>
        <p>
          Each week you write your sentence and submit it 24 hours before the live session. Your document then locks so I can read it and prepare my feedback. The session is for feedback and rewriting, not lectures.
        </p>
      </div>
    </section>

    <section class="clinic-section container" aria-labelledby="slot-heading">
      <h2 id="slot-heading">Your weekly 12 minutes</h2>
      <div class="clinic-timeline-wrapper">
        <div class="timeline-grid">
          <div class="time-slot"><strong>Minutes 0 to 2</strong> You read your sentence aloud.</div>
          <div class="time-slot"><strong>Minutes 2 to 5</strong> I ask questions about it.</div>
          <div class="time-slot"><strong>Minutes 5 to 10</strong> We rewrite it together.</div>
          <div class="time-slot"><strong>Minutes 10 to 12</strong> We check it fits with your other sentences.</div>
        </div>
        <p class="clinic-footnote">
          The other three students listen and apply what they hear to their own sentence.
        </p>
      </div>
    </section>

    <section class="registry-section container" aria-labelledby="problems-heading">
      <div class="section-meta">
        <h2 id="problems-heading">Five common argument problems</h2>
        <p class="section-desc">
          These are the problems I look for in every sentence. The examples come from an invented half-thesis on phrasing in a Brahms intermezzo.
        </p>
      </div>
      <div class="problem-grid">
        {problems.map((p) => (
          <article class="problem-card">
            <h3>{p.title}</h3>
            <p>{p.looks}</p>
            <p class="example"><span class="example-label">Before</span> {p.before}</p>
            <p class="example"><span class="example-label">Fix</span> {p.fix}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container about-section" aria-labelledby="about-heading">
  <h2 id="about-heading">About me</h2>
  <div class="about-layout">
    <img
      class="about-photo"
      src="/images/john-oosthuizen.jpg"
      alt="Portrait of Dr John Oosthuizen"
      width="320"
      height="320"
      loading="lazy"
      decoding="async"
    />
    <p class="about-text">{settings.bio}</p>
  </div>
</section>

    <section class="coaching-section container" aria-labelledby="join-heading">
      <h2 id="join-heading">Ways to join</h2>
      <div class="table-responsive">
        <table class="pricing-table" aria-label="Ways to join">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Detail</span></th>
              <th scope="col">Pilot cohort</th>
              <th scope="col">Group clinic</th>
              <th scope="col">One-to-one</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Price</th>
              <td>Free</td>
              <td>{or(settings.groupPrice, 'Price on request')}</td>
              <td>{or(settings.oneToOnePrice, 'Price on request')}</td>
            </tr>
            <tr>
              <th scope="row">Group size</th>
              <td>Up to 4 students</td>
              <td>Up to 4 students</td>
              <td>1 student</td>
            </tr>
            <tr>
              <th scope="row">Length</th>
              <td>4 weeks</td>
              <td>4 weeks</td>
              <td>Your timeline</td>
            </tr>
            <tr>
              <th scope="row">Best for</th>
              <td>Students happy to give honest feedback and, if willing, a short testimonial</td>
              <td>Anyone who wants a clear argument and learns well from other people’s sentences</td>
              <td>Close deadlines, or a proposal that needs a rewrite</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="container faq-section" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Questions</h2>
      <div class="faq-list">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="pipeline-gateways container">
      <div class="gate-card">
        <h3>My qualifications and publications</h3>
        <p>Degree documents, examiner evaluations and publications.</p>
        <a href="/vault" class="button-secondary">View documents</a>
      </div>

      <div class="gate-card highlighted-gate">
        <h3>Apply for a place</h3>
        <p>Tell me about your project. A rough topic is fine. You can also ask a question first.</p>
        <a href="/register" class="button-primary">Apply for a place</a>
      </div>
    </section>

    <footer class="legal-attribution container">
      <p>© 2026 Dr. John Ernst Oosthuizen. All rights reserved. · <a href="/privacy">Privacy notice</a></p>
    </footer>
  </main>
</Layout>

<style>
  .brand-name { font-family: var(--font-sans); font-weight: 600; color: var(--text-muted); margin: 0 0 0.75rem 0; }
  .hero-actions { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .button-primary, .button-secondary { font-family: var(--font-sans); font-size: var(--step-0); font-weight: 600; text-decoration: none; padding: 0.9rem 1.6rem; border-radius: 4px; border: 1px solid var(--brand-accent, #127C44); }
  .button-primary { background: var(--brand-accent, #127C44); color: #ffffff; }
  .button-primary:hover { filter: brightness(0.92); }
  .button-secondary { color: var(--text-primary); border-color: var(--text-primary); }
  .button-secondary:hover { background: var(--action-hover); color: var(--action-text-hover); }
  .button-primary:focus-visible, .button-secondary:focus-visible, .gate-link:focus-visible, summary:focus-visible { outline: 3px solid var(--brand-accent, #127C44); outline-offset: 3px; }
  .button-primary, .button-secondary { display: inline-block; min-width: 11rem; text-align: center; }
  .gate-card .button-primary, .gate-card .button-secondary { align-self: flex-start; }
  .hero-note { color: var(--text-muted); font-size: var(--step-0); margin: 0; }

  .audience-section, .leave-section, .about-section, .faq-section { margin-bottom: 5rem; }
  .audience-section h2, .leave-section h2, .about-section h2, .faq-section h2 { border-left: 2px solid var(--text-primary); padding-left: 1rem; margin-bottom: 2rem; }
  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; align-items: start; }
  .plain-list { margin: 0; padding-left: 1.25rem; max-width: 62ch; }
  .plain-list li { margin-bottom: 0.75rem; }
  .note-box { background: var(--bg-surface); border: 1px solid var(--border-accent); padding: 1.5rem 2rem; border-radius: 4px; }
  .note-box h3 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .note-box p { margin: 0; color: var(--text-muted); }
  .about-text { max-width: 62ch; font-size: var(--step-1); }

  .hourglass-layout { display: grid; grid-template-columns: minmax(140px, 200px) 1fr; gap: 3rem; align-items: center; }
  .hourglass-figure { color: var(--brand-accent, #127C44); width: 100%; max-width: 200px; margin: 0 auto; }
  .hourglass-parts { display: grid; gap: 1.25rem; }
  .hourglass-parts .matrix-node { padding: 1.25rem 1.5rem; }
  .hourglass-parts .matrix-node h3 { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .hourglass-parts .matrix-node p { margin: 0; color: var(--text-muted); font-size: var(--step-0); }
  @media (max-width: 640px) { .hourglass-layout { grid-template-columns: 1fr; gap: 1.5rem; } }

  .problem-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .problem-card { background: var(--bg-surface); border: 1px solid var(--border-accent); padding: 1.75rem; border-radius: 4px; }
  .problem-card h3 { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .problem-card p { margin: 0 0 0.75rem 0; font-size: var(--step-0); }
  .example { color: var(--text-muted); }
  .example-label { font-family: var(--font-sans); font-weight: 700; color: var(--text-primary); margin-right: 0.35rem; }

  .pricing-table th[scope="row"] { background: transparent; text-transform: none; letter-spacing: 0; font-size: var(--step-0); }

  .faq-list details { border-bottom: 1px solid var(--border-accent); padding: 1rem 0; max-width: 70ch; }
  .faq-list summary { font-family: var(--font-sans); font-weight: 600; cursor: pointer; }
  .faq-list p { margin: 0.75rem 0 0 0; color: var(--text-muted); }

  .legal-attribution a { color: inherit; }

  .payoff {
      font-size: var(--step-1);
      max-width: 56ch;
      margin: 2.5rem 0;
      padding-left: 1.25rem;
      border-left: 4px solid var(--brand-accent, #127C44);
  }

  .about-layout { display: grid; grid-template-columns: 200px 1fr; gap: 2rem; align-items: start; }
  .about-photo { width: 200px; height: 200px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-accent); }
  
  @media (max-width: 640px) {
  .about-layout { grid-template-columns: 1fr; }
  .about-photo { width: 160px; height: 160px; }
}
</style>
