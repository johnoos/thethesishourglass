---
// src/pages/vault.astro
import { vaultFiles } from '../data/vault.js';

export const prerender = true;

// Color palette derived strictly from the signature hourglass accent
const BRAND_ACCENT = "#127C44"; 
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <title>Document Vault | The Logic Pipeline</title>
  <style>
    body {
      background-color: #f7f4ec;
      color: #1c1f26;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      border-top: 6px solid #14213d;
      margin: 0;
      padding: 40px 20px;
      display: flex;
      justify-content: center;
    }
    .vault-container {
      max-width: 650px;
      width: 100%;
    }
    h1 {
      font-family: 'Libre Caslon Text', Georgia, serif;
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: #14213d;
      margin-bottom: 8px;
      border-bottom: 2px solid #b08d57;
      padding-bottom: 12px;
    }
    p {
      font-size: 1.05rem;
      line-height: 1.5;
      color: #4f5360;
      margin-bottom: 32px;
    }
    .file-item {
      margin-bottom: 14px;
    }
    .file-list {
      list-style: none !important;      
      list-style-type: none !important; 
      padding: 0;
      margin: 0;
    }
    .file-link,
    .file-link span,
    .file-name {
      color: #4f5360 !important; 
      text-decoration: none;
      font-size: 1.15rem;
      display: inline-flex;
      align-items: center;
      transition: color 0.2s ease;
    }
    .bullet {
      color: #8a6a35 !important; 
      margin-right: 12px;
      font-weight: bold;
    }
    .file-link:hover,
    .file-link:hover span {
      color: #14213d !important; 
    }
  </style>
</head>
<body>
  <div class="vault-container" style={`--accent: ${BRAND_ACCENT};`}>
    <h1>Academic &amp; Professional Credentials</h1>
    <p>Direct verification repository for postgraduate records, independent evaluations, and technical documentation.</p>
    
    <ul class="file-list">
      {vaultFiles.map(file => (
        <li class="file-item">
          <a class="file-link" href={`/assets/${file.slug}`} target="_blank" rel="noopener noreferrer">
            <span class="bullet">■</span>
            <span>{file.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</body>
</html>